{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCode Workspace Config",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "github": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["name", "slug", "description", "author"]
    },
    "tech": {
      "type": "object",
      "properties": {
        "framework": { "type": "string" },
        "language": { "type": "string" },
        "database": { "type": "string" },
        "db_file": { "type": "string" },
        "styling": { "type": "string" },
        "test_unit": { "type": "string" },
        "test_e2e": { "type": "string" },
        "package_manager": { "type": "string", "enum": ["npm", "yarn", "pnpm", "bun"] }
      },
      "required": ["framework", "language", "database", "package_manager"]
    },
    "deploy": {
      "type": "object",
      "properties": {
        "method": { "type": "string" },
        "script": { "type": "string" },
        "ssh_key": { "type": "string" },
        "remote_user": { "type": "string" },
        "remote_host": { "type": "string" },
        "pm2_app": { "type": "string" },
        "log_file": { "type": "string" }
      }
    },
    "mcps": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "agents": {
      "type": "object",
      "properties": {
        "deploy": { "type": "boolean" },
        "qa": { "type": "boolean" },
        "db": { "type": "boolean" },
        "plugin-dev": { "type": "boolean" }
      }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["project", "tech", "mcps", "agents"]
}
