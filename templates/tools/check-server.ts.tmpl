/**
 * check-server — OpenCode custom tool for {{projectName}}
 * Checks server status over SSH: PM2 processes and deploy logs.
 */
import { tool } from "opencode/tool";
import { z } from "zod";
import { exec } from "child_process";
import { promisify } from "util";

const execAsync = promisify(exec);

const SSH_CMD = "ssh -i {{deploySshKey}} -o ConnectTimeout=10 -o StrictHostKeyChecking=no {{deployRemoteUser}}@{{deployRemoteHost}}";

export default tool({
  description:
    "Check the status of the remote server for {{projectName}} (PM2 process list and last 15 lines of deploy logs). Use this to verify the app is running after a deploy or when debugging production issues.",
  args: z.object({
    lines: z
      .number()
      .optional()
      .default(15)
      .describe("Number of deploy.log lines to return (default 15)"),
  }),
  execute: async ({ lines }) => {
    try {
      const { stdout, stderr } = await execAsync(
        `${SSH_CMD} "pm2 list && echo '---DEPLOY LOG---' && tail -${lines} {{deployLogFile}}"`,
        { timeout: 20000 }
      );
      return stdout || stderr || "No output received";
    } catch (err: any) {
      if (err.code === "ETIMEDOUT" || err.message?.includes("timed out")) {
        return "❌ Connection timed out. Server may be unreachable. Check your VPN or network.";
      }
      return `❌ SSH Error: ${err.message}`;
    }
  },
});
